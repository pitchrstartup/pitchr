generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ImportedProject {
  id              String @id @default(cuid())
  source          String
  sourceProjectId String
  sourceUrl       String

  name                String
  description         String
  category            String
  iconUrl             String
  twitterUrl          String
  createdAtFromSource DateTime?
  lastSyncedAt        DateTime?
  sourceCreatedAt     DateTime?

  sourceUserId        String?
  sourceStatus        String?
  tokenAddress        String?
  upvotes             Int?
  downvotes           Int?
  twitterUserId       String?
  twitterUsername     String?
  twitterName         String?
  twitterProfileImage String?
  twitterVerified     Boolean?

  rawPayload       Json                    @default("{}")
  rawListPayload   Json                    @default("{}")
  rawDetailPayload Json                    @default("{}")
  updates          ImportedProjectUpdate[]

  createdAt  DateTime @default(now())
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, sourceProjectId])
}

model ImportedProjectUpdate {
  id                String @id @default(cuid())
  source            String
  sourceUpdateId    String
  sourceProjectId   String
  sourceProjectUuid String
  projectId         String

  sourceUserId        String?
  contentText         String?
  createdAtFromSource DateTime?
  updatedAtFromSource DateTime?
  rawPayload          Json      @default("{}")

  createdAt  DateTime @default(now())
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project ImportedProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([source, sourceUpdateId])
  @@index([sourceProjectId])
  @@index([source, sourceProjectUuid])
  @@index([projectId, createdAtFromSource])
}

model ImportedTokenMetrics {
  id                     String  @id @default(cuid())
  source                 String
  tokenMint              String
  lifetimeFeesLamports   String?
  claimsTotalLamports    String?
  claimsCreatorLamports  String?
  claimsUniqueWallets    Int?
  creatorCount           Int?
  hasCreator             Boolean?
  creatorsDataStatus     String?
  creatorWallets         Json    @default("[]")
  rawLifetimeFeesPayload Json    @default("{}")
  rawClaimStatsPayload   Json    @default("{}")
  rawLaunchCreatorsPayload Json  @default("{}")
  lastFetchedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, tokenMint])
  @@index([tokenMint])
}

model Project {
  id              String  @id @default(cuid())
  slug            String  @unique
  source          String
  sourceProjectId String
  sourceUrl       String?

  name         String
  description  String?
  category     String?
  iconUrl      String?
  sourceStatus String?
  tokenAddress String?

  sourceUserId String?

  twitterUrl          String?
  twitterUserId       String?
  twitterUsername     String?
  twitterName         String?
  twitterProfileImage String?
  twitterVerified     Boolean?

  twitterDescription    String?
  twitterCreatedAt      DateTime?
  twitterVerifiedType   String?
  twitterUserUrl        String?
  twitterFollowersCount Int?
  twitterFollowingCount Int?
  twitterTweetCount     Int?
  twitterListedCount    Int?
  twitterLikeCount      Int?
  twitterMediaCount     Int?

  upvotes   Int?
  downvotes Int?

  lifetimeFeesLamports  String?
  claimsTotalLamports   String?
  claimsCreatorLamports String?
  claimsUniqueWallets   Int?
  creatorCount          Int?
  hasLaunchCreator      Boolean?
  creatorsDataStatus    String?
  hasToken              Boolean?
  hasLinkedCreator      Boolean?
  creatorProjectsCount  Int?
  creatorTokenProjectsCount Int?
  updatesCount          Int?
  lastUpdateAt          DateTime?

  createdAtFromSource DateTime?
  sourceCreatedAt     DateTime?

  rawListPayload   Json @default("{}")
  rawDetailPayload Json @default("{}")

  projectCreators ProjectCreator[]
  projectTokens   ProjectToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, sourceProjectId])
}

model Creator {
  id                   String  @id @default(cuid())
  source               String
  identityKey          String  @unique
  sourceUserId         String?
  twitterUserId        String?
  twitterUsername      String?
  twitterName          String?
  twitterVerified      Boolean?
  twitterFollowersCount Int?
  twitterProfileImage  String?

  projectLinks ProjectCreator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, sourceUserId])
  @@index([source, twitterUserId])
}

model Token {
  id                   String  @id @default(cuid())
  source               String
  mint                 String
  lifetimeFeesLamports String?
  claimsTotalLamports  String?
  claimsCreatorLamports String?
  claimsUniqueWallets  Int?
  creatorCount         Int?
  hasCreator           Boolean?
  creatorsDataStatus   String?
  lastFetchedAt        DateTime?

  projectLinks ProjectToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, mint])
  @@index([mint])
}

model ProjectCreator {
  id          String  @id @default(cuid())
  projectId   String
  creatorId   String
  role        String  @default("primary")
  matchSource String?
  confidence  Float?
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([projectId, creatorId, role])
  @@index([creatorId, role])
  @@index([projectId, role])
}

model ProjectToken {
  id        String   @id @default(cuid())
  projectId String
  tokenId   String
  role      String   @default("primary")
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token   Token   @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([projectId, tokenId, role])
  @@index([tokenId, role])
  @@index([projectId, role])
}

model ImportCursor {
  id        String   @id @default(cuid())
  key       String   @unique
  cursor    Int      @default(0)
  batchSize Int?
  metadata  Json     @default("{}")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
