generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ImportedProject {
  id              String @id @default(cuid())
  source          String
  sourceProjectId String
  sourceUrl       String

  name                String
  description         String
  category            String
  iconUrl             String
  twitterUrl          String
  createdAtFromSource DateTime?
  lastSyncedAt        DateTime?
  sourceCreatedAt     DateTime?

  sourceUserId        String?
  sourceStatus        String?
  tokenAddress        String?
  upvotes             Int?
  downvotes           Int?
  twitterUserId       String?
  twitterUsername     String?
  twitterName         String?
  twitterProfileImage String?
  twitterVerified     Boolean?

  rawPayload       Json                    @default("{}")
  rawListPayload   Json                    @default("{}")
  rawDetailPayload Json                    @default("{}")
  updates          ImportedProjectUpdate[]

  createdAt  DateTime @default(now())
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, sourceProjectId])
}

model ImportedProjectUpdate {
  id                String @id @default(cuid())
  source            String
  sourceUpdateId    String
  sourceProjectId   String
  sourceProjectUuid String
  projectId         String

  sourceUserId        String?
  contentText         String?
  createdAtFromSource DateTime?
  updatedAtFromSource DateTime?
  rawPayload          Json      @default("{}")

  createdAt  DateTime @default(now())
  importedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project ImportedProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([source, sourceUpdateId])
  @@index([sourceProjectId])
  @@index([source, sourceProjectUuid])
  @@index([projectId, createdAtFromSource])
}
