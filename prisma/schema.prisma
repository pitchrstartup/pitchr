generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(cuid())
  name          String
  tagline       String // short hook line (max 100 chars)
  description   String // full description (max 500 chars)
  logoUrl       String?
  twitterUrl    String?
  websiteUrl    String?
  tokenMint     String? // Bags token address if applicable
  builderName   String
  builderAvatar String?
  createdAt     DateTime @default(now())
  swipes        Swipe[]
}

model Swipe {
  id        String    @id @default(cuid())
  userId    String
  projectId String
  direction Direction
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  avatar    String?
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  swipes    Swipe[]
  sessions  Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ImportedProject {
  id                  String    @id @default(cuid())
  source              String
  sourceProjectId     String
  sourceUrl           String
  name                String?
  description         String?
  category            String?
  sourceStatus        String?
  iconUrl             String?
  twitterUrl          String?
  tokenAddress        String?
  upvotes             Int?
  downvotes           Int?
  sourceCreatedAt     DateTime?
  twitterUserId       String?
  twitterUsername     String?
  twitterName         String?
  twitterProfileImage String?
  twitterVerified     Boolean?
  rawListPayload      Json?
  rawDetailPayload    Json?
  lastSyncedAt        DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([source, sourceProjectId])
  @@index([source, lastSyncedAt])
}

enum Direction {
  RIGHT
  LEFT
}

enum Role {
  USER
  ADMIN
}
